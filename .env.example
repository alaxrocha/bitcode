# Copie para .env (desenvolvimento) e cadastre os mesmos valores como
# variáveis/segredos do Worker na Cloudflare (produção).

# --- Formulário de contato (envio por e-mail via https://resend.com) ---
RESEND_API_KEY=
# Quem recebe os contatos (separe vários por vírgula)
CONTACT_TO=contato@bitcode.dev.br
# Remetente: precisa ser de um domínio verificado no Resend
CONTACT_FROM="Site bitCode <site@bitcode.dev.br>"

# --- Anti-spam (Cloudflare Turnstile) ---
# Sem as duas chaves, o formulário funciona sem o desafio anti-spam
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Painel (Keystatic) no modo GitHub ---
# No site publicado o painel grava no GitHub (cada salvamento = um commit,
# que dispara um novo deploy). O próprio Keystatic gera estes valores ao
# criar o GitHub App (veja docs/publicacao.md, passo 4).
# Para usar o modo GitHub no `npm run dev`, descomente:
# PUBLIC_KEYSTATIC_STORAGE=github
# Público, entra no build (na Cloudflare: variável de BUILD):
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Segredos do Worker (na Cloudflare: secrets de runtime):
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
