---
/** "O que está incluso": usado nas páginas de serviço e nicho. */
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import type { Tone } from '@core/lib/types';

interface Props {
  tone?: Extract<Tone, 'white' | 'light'>;
  title: string;
  items: string[];
}

const { tone = 'light', title, items } = Astro.props;
---

<Section tone={tone} spacing="md">
  <SectionHeading title={title} />
  <ul class="mt-10 grid gap-x-10 gap-y-4 sm:grid-cols-2">
    {
      items.map((i) => (
        <li class="flex items-start gap-3 text-lg">
          <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-primary text-white">
            <Icon name="check" size={16} />
          </span>
          {i}
        </li>
      ))
    }
  </ul>
</Section>
