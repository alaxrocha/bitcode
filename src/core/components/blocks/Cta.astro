---
import ActionButton from '../ui/ActionButton.astro';
import type { Action } from '@core/lib/types';

interface Props {
  id?: string;
  tone?: 'primary' | 'dark';
  title: string;
  text?: string;
  action: Action;
}

const { id, tone = 'primary', title, text, action } = Astro.props;
---

<section id={id} class:list={['scroll-mt-20 text-white', tone === 'primary' ? 'bg-primary' : 'bg-dark']}>
  <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 sm:py-24">
    <h2 class="text-3xl font-semibold sm:text-5xl sm:leading-[1.1]">{title}</h2>
    {text && <p class:list={['mt-4 text-lg', tone === 'primary' ? 'text-[#ede6ff]' : 'text-muted-dark']}>{text}</p>}
    <div class="mt-9">
      <ActionButton action={action} variant={tone === 'primary' ? 'dark' : 'accent'} size="lg" />
    </div>
  </div>
</section>
