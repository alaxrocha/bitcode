---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { FeatureItem, Tone } from '@core/lib/types';

interface Props {
  tone?: Extract<Tone, 'dark' | 'white' | 'light'>;
  eyebrow?: string;
  title: string;
  text?: string;
  items: FeatureItem[];
}

const { tone = 'dark', eyebrow, title, text, items } = Astro.props;
const inverted = tone === 'dark';
---

<Section tone={tone}>
  <SectionHeading eyebrow={eyebrow} title={title} text={text} inverted={inverted} />
  <ul class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    {
      items.map((f) => (
        <li>
          <div class="mb-5 flex gap-1" aria-hidden="true">
            <span class="size-2.5 bg-accent" />
            <span class="size-2.5 bg-primary" />
          </div>
          <h3 class="text-xl font-semibold">{f.title}</h3>
          <p class:list={['mt-2.5 leading-relaxed', inverted ? 'text-muted-dark' : 'text-muted']}>{f.text}</p>
        </li>
      ))
    }
  </ul>
</Section>
