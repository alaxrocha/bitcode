---
/** Página "em construção", exibida no lugar de todo o site quando settings.comingSoon está ligado. */
import Logo from '../ui/Logo.astro';
import PixelDeco from '../ui/PixelDeco.astro';
import { site } from '@core/lib/settings';
import { whatsappUrl } from '@core/lib/whatsapp';

// Só mostra o WhatsApp quando o número real estiver cadastrado (não o de exemplo).
const hasWhatsapp = /[1-9]/.test(site.whatsapp.number.slice(2));
---

<main
  id="conteudo"
  class="relative flex min-h-dvh items-center overflow-hidden bg-dark px-4 py-16 text-white"
>
  <div
    class="pointer-events-none absolute -top-40 -right-40 size-[28rem] rounded-full bg-primary/30 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto w-full max-w-2xl">
    <Logo variant="dark" size="lg" href={null} />
    <p class="eyebrow-dark mt-12">Em construção</p>
    <h1 class="mt-3 font-heading text-4xl font-bold leading-tight sm:text-5xl">
      Novo site <span class="text-accent">em breve</span>.
    </h1>
    {site.comingSoonText && <p class="mt-5 max-w-xl text-lg text-muted-dark">{site.comingSoonText}</p>}

    <div class="mt-10 flex flex-wrap items-center gap-3">
      {
        hasWhatsapp && (
          <a
            href={whatsappUrl(site.whatsapp.message)}
            class="inline-flex items-center gap-2 rounded-btn bg-whatsapp px-5 py-3 font-semibold text-white no-underline hover:brightness-110"
            target="_blank"
            rel="noopener"
          >
            Falar no WhatsApp
          </a>
        )
      }
      {
        site.email && (
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center rounded-btn border border-white/20 px-5 py-3 font-semibold text-white no-underline hover:border-accent hover:text-accent"
          >
            {site.email}
          </a>
        )
      }
    </div>

    <PixelDeco class="mt-16 opacity-80" />
  </div>
</main>
