---
import { whatsappUrl } from '@core/lib/whatsapp';
import Icon from '../ui/Icon.astro';

interface Props {
  message?: string;
}

const { message } = Astro.props;
---

<a
  href={whatsappUrl(message)}
  target="_blank"
  rel="noopener"
  aria-label="Conversar no WhatsApp"
  class="fixed right-4 bottom-4 z-50 inline-flex size-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-lg shadow-black/20 transition hover:scale-105 sm:right-6 sm:bottom-6 sm:size-15"
>
  <Icon name="whatsapp" size={28} />
</a>
