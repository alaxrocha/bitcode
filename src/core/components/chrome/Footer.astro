---
import { site } from '@site/config';
import { whatsappUrl } from '@core/lib/whatsapp';
import Logo from '../ui/Logo.astro';

const year = new Date().getFullYear();
---

<footer class="bg-dark text-muted-dark">
  <div class="mx-auto max-w-6xl px-4 pt-16 pb-8 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <Logo variant="dark" />
        <p class="mt-4 text-[15px] leading-relaxed">{site.tagline}</p>
        {
          site.social.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-4 text-[15px]">
              {site.social.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener" class="text-muted-dark hover:text-white">
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        site.footer.map((col) => (
          <div>
            <p class="mb-3 font-semibold text-white">{col.title}</p>
            <ul class="flex flex-col gap-2.5 text-[15px]">
              {col.links.map((l) => (
                <li>
                  <a href={l.href} class="text-muted-dark no-underline hover:text-white">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div>
        <p class="mb-3 font-semibold text-white">Contato</p>
        <ul class="flex flex-col gap-2.5 text-[15px]">
          <li>
            <a href={whatsappUrl()} target="_blank" rel="noopener" class="text-muted-dark hover:text-white">WhatsApp</a>
          </li>
          <li>
            <a href={`mailto:${site.email}`} class="text-muted-dark hover:text-white">{site.email}</a>
          </li>
          <li>{site.serviceArea}</li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-wrap justify-between gap-4 border-t border-white/10 pt-6 text-sm text-faint-dark">
      <span>© {year} {site.name}. Todos os direitos reservados.</span>
      <a href="/privacidade" class="text-faint-dark hover:text-white">Política de Privacidade</a>
    </div>
  </div>
</footer>
