---
/**
 * Home provisória da Fase 1: só o hero, para validar tema, layout e componentes.
 * Na Fase 2 a página passa a ser montada com os blocos.
 */
import PageLayout from '@core/layouts/PageLayout.astro';
import Container from '@core/components/ui/Container.astro';
import Button from '@core/components/ui/Button.astro';
import PixelDeco from '@core/components/ui/PixelDeco.astro';
import { whatsappUrl } from '@core/lib/whatsapp';
---

<PageLayout description="Agência digital com mais de 20 anos de experiência. Criamos sites rápidos, landing pages que convertem e estratégias de SEO para todo o Brasil.">
  <section class="overflow-hidden bg-dark text-white">
    <Container class="grid items-center gap-16 py-20 md:py-28 lg:grid-cols-[1.15fr_1fr]">
      <div>
        <p class="eyebrow-dark mb-5">&lt;agência digital /&gt;</p>
        <h1 class="text-4xl leading-[1.05] font-semibold sm:text-5xl lg:text-6xl">
          Sites rápidos, bonitos e feitos para <span class="text-primary-soft">vender.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-dark">
          Criação de sites, landing pages e SEO com mais de 20 anos de experiência em código. Projeto sob medida, sem
          template genérico.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href={whatsappUrl('Olá! Quero um orçamento para um projeto.')} variant="accent" size="lg" icon="whatsapp" external>
            Pedir orçamento no WhatsApp
          </Button>
          <Button href="/portfolio" variant="ghost" size="lg">Ver portfólio</Button>
        </div>
      </div>

      <div class="relative hidden sm:block">
        <PixelDeco class="absolute -top-7 -right-3" />
        <div class="overflow-hidden rounded-[var(--radius-card)] border border-primary-soft/25 bg-dark-2">
          <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3.5">
            <span class="size-2.5 rounded-full bg-[#3b2f5c]"></span>
            <span class="size-2.5 rounded-full bg-[#3b2f5c]"></span>
            <span class="size-2.5 rounded-full bg-[#3b2f5c]"></span>
            <span class="ml-3 flex-1 rounded-md bg-dark px-3 py-1.5 font-mono text-xs text-faint-dark">seunegocio.com.br</span>
          </div>
          <div class="grid gap-4 p-7">
            <div class="flex items-center gap-4">
              <div class="flex size-23 shrink-0 items-center justify-center rounded-full border-[6px] border-accent font-heading text-3xl font-semibold">
                98
              </div>
              <div>
                <p class="font-medium">Performance</p>
                <p class="mt-1 text-sm text-faint-dark">Google PageSpeed, celular</p>
              </div>
            </div>
            <div class="grid grid-cols-3 gap-2.5">
              <div class="rounded-xl bg-dark p-3.5">
                <p class="font-heading text-xl font-semibold">0,8s</p>
                <p class="mt-0.5 text-xs text-faint-dark">carregamento</p>
              </div>
              <div class="rounded-xl bg-dark p-3.5">
                <p class="font-heading text-xl font-semibold">100</p>
                <p class="mt-0.5 text-xs text-faint-dark">SEO</p>
              </div>
              <div class="rounded-xl bg-dark p-3.5">
                <p class="font-heading text-xl font-semibold">100%</p>
                <p class="mt-0.5 text-xs text-faint-dark">responsivo</p>
              </div>
            </div>
            <pre class="overflow-x-auto rounded-xl bg-dark px-4 py-3.5 font-mono text-[13px] leading-7 text-faint-dark"><span class="text-primary-soft">const</span> site = <span class="text-accent">bitCode</span>.build({'{'}
  rapido: <span class="text-primary-soft">true</span>,
  noGoogle: <span class="text-primary-soft">true</span>,
  vende: <span class="text-primary-soft">true</span>
{'}'});</pre>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="bg-light">
    <Container class="py-20 text-center">
      <p class="eyebrow">// em construção</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">As demais seções chegam na Fase 2</h2>
      <p class="mx-auto mt-4 max-w-xl text-muted">Esta página valida o tema, o cabeçalho, o rodapé e o botão do WhatsApp.</p>
    </Container>
  </section>
</PageLayout>
