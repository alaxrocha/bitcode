---
import PageLayout from '@core/layouts/PageLayout.astro';
import BlockRenderer from '@core/components/blocks/BlockRenderer.astro';
import { reader } from '@core/lib/content';
import { site } from '@core/lib/settings';

const home = await reader.singletons.home.readOrThrow();
const description = home.seoDescription || site.description;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description,
  url: site.url,
  email: site.email || undefined,
  areaServed: { '@type': 'Country', name: 'Brasil' },
};
---

<PageLayout title={home.seoTitle || undefined} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <BlockRenderer blocks={home.blocks} />
</PageLayout>
