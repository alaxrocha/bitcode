---
import PageLayout from '@core/layouts/PageLayout.astro';
import Hero from '@core/components/blocks/Hero.astro';
import Section from '@core/components/ui/Section.astro';
import Cta from '@core/components/blocks/Cta.astro';
import { reader } from '@core/lib/content';
import { breadcrumbSchema, type Crumb } from '@core/lib/schema';

const posts = (await reader.collections.posts.all()).sort((a, b) => (b.entry.date || '').localeCompare(a.entry.date || ''));
const crumbs: Crumb[] = [{ label: 'Início', href: '/' }, { label: 'Blog' }];
const fmt = (d: string | null) =>
  d ? new Date(`${d}T12:00:00`).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }) : '';
---

<PageLayout title="Blog" description="Dicas sobre sites, landing pages, SEO e presença digital para pequenas e médias empresas.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema(crumbs, '/blog'))} />

  <Hero
    title="Blog"
    text="Dicas práticas sobre sites, landing pages e SEO para fazer seu negócio crescer na internet."
    visual="none"
    breadcrumb={crumbs}
  />

  <Section>
    {
      posts.length === 0 ? (
        <div class="mx-auto max-w-xl py-10 text-center">
          <p class="font-mono text-sm text-primary">// em breve</p>
          <h2 class="mt-3 text-2xl font-semibold">Os primeiros artigos estão chegando</h2>
          <p class="mt-3 text-muted">Enquanto isso, se tiver alguma dúvida sobre seu site, chame a gente no WhatsApp.</p>
        </div>
      ) : (
        <ul class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((p) => (
            <li>
              <a href={`/blog/${p.slug}`} class="group block text-ink no-underline">
                <div class="aspect-[16/10] overflow-hidden rounded-[var(--radius-card)] bg-light">
                  {p.entry.cover && (
                    <img src={p.entry.cover} alt="" loading="lazy" class="size-full object-cover transition duration-500 group-hover:scale-105" />
                  )}
                </div>
                <p class="mt-4 text-sm text-muted">
                  <time datetime={p.entry.date ?? undefined}>{fmt(p.entry.date)}</time>
                </p>
                <h2 class="mt-1 text-xl font-semibold group-hover:text-primary">{p.entry.title}</h2>
                {p.entry.summary && <p class="mt-2 leading-relaxed text-muted">{p.entry.summary}</p>}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </Section>

  <Cta title="Precisa de ajuda com seu site?" action={{ label: 'Chamar no WhatsApp', whatsapp: '' }} />
</PageLayout>
